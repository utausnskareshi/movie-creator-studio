{
  "unet_high": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_fun_control_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load Diffusion Model (High Noise)" }
  },
  "unet_low": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_fun_control_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load Diffusion Model (Low Noise)" }
  },
  "lora_high": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["unet_high", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
      "strength_model": 1.0
    },
    "_meta": { "title": "Lightning LoRA (high)" }
  },
  "model_sampling_high": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["lora_high", 0],
      "shift": 8.0
    },
    "_meta": { "title": "ModelSamplingSD3 (High Noise)" }
  },
  "lora_low": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["unet_low", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
      "strength_model": 1.0
    },
    "_meta": { "title": "Lightning LoRA (low)" }
  },
  "model_sampling_low": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["lora_low", 0],
      "shift": 8.0
    },
    "_meta": { "title": "ModelSamplingSD3 (Low Noise)" }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "_meta": { "title": "Load CLIP" }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["clip", 0]
    },
    "_meta": { "title": "CLIP Text Encode (Positive Prompt)" }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": ["clip", 0]
    },
    "_meta": { "title": "CLIP Text Encode (Negative Prompt)" }
  },
  "load_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": { "title": "Load Reference Image" }
  },
  "load_video": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "control.mp4"
    },
    "_meta": { "title": "Load Control Video" }
  },
  "get_video": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["load_video", 0]
    },
    "_meta": { "title": "Get Video Components" }
  },
  "fun_control": {
    "class_type": "Wan22FunControlToVideo",
    "inputs": {
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "vae": ["vae", 0],
      "width": 640,
      "height": 640,
      "length": 81,
      "batch_size": 1,
      "ref_image": ["load_image", 0],
      "control_video": ["get_video", 0]
    },
    "_meta": { "title": "Wan22 Fun Control To Video" }
  },
  "sampler_1": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["model_sampling_high", 0],
      "add_noise": "enable",
      "noise_seed": 0,
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["fun_control", 0],
      "negative": ["fun_control", 1],
      "latent_image": ["fun_control", 2],
      "start_at_step": 0,
      "end_at_step": 10,
      "return_with_leftover_noise": "enable"
    },
    "_meta": { "title": "KSampler (Advanced) - High Noise" }
  },
  "sampler_2": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["model_sampling_low", 0],
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["fun_control", 0],
      "negative": ["fun_control", 1],
      "latent_image": ["sampler_1", 0],
      "start_at_step": 10,
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable"
    },
    "_meta": { "title": "KSampler (Advanced) - Low Noise" }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    },
    "_meta": { "title": "Load VAE" }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sampler_2", 0],
      "vae": ["vae", 0]
    },
    "_meta": { "title": "VAE Decode" }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode", 0],
      "fps": 16.0
    },
    "_meta": { "title": "Create Video" }
  },
  "save_video": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["create_video", 0],
      "filename_prefix": "video/mcs",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": { "title": "Save Video" }
  }
}
