{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load MiniMax H3 Ref2VA (int8)"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": {
      "title": "Load Qwen3-VL Text Encoder (nvfp4)"
    }
  },
  "vae_video": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    },
    "_meta": {
      "title": "Load Video VAE"
    }
  },
  "vae_audio": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "_meta": {
      "title": "Load Audio VAE"
    }
  },
  "cond": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae_video",
        0
      ],
      "audio_vae": [
        "vae_audio",
        0
      ],
      "prompt": "",
      "width": 1344,
      "height": 768,
      "length": 124,
      "ref_image_size": "match"
    },
    "_meta": {
      "title": "MiniMax H3 Reference to Video (ref2va)"
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    },
    "_meta": {
      "title": "Random Noise"
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "conditioning": [
        "cond",
        0
      ]
    },
    "_meta": {
      "title": "Basic Guider"
    }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "_meta": {
      "title": "Sampler Select"
    }
  },
  "scheduler": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    },
    "_meta": {
      "title": "Basic Scheduler"
    }
  },
  "sampler_1": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler_select",
        0
      ],
      "sigmas": [
        "scheduler",
        0
      ],
      "latent_image": [
        "cond",
        1
      ]
    },
    "_meta": {
      "title": "Sampler Custom Advanced"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler_1",
        0
      ],
      "vae": [
        "vae_video",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode (video)"
    }
  },
  "audio_decode": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "sampler_1",
        0
      ],
      "vae": [
        "vae_audio",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode (audio)"
    }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "audio": [
        "audio_decode",
        0
      ],
      "fps": 24
    },
    "_meta": {
      "title": "Create Video"
    }
  },
  "save_video": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "create_video",
        0
      ],
      "filename_prefix": "video/mcs",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save Video"
    }
  }
}
