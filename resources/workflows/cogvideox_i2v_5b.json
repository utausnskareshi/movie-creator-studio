{
  "model_loader": {
    "class_type": "CogVideoXModelLoader",
    "inputs": {
      "model": "CogVideoX_1_0_5b_I2V_bf16.safetensors",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "main_device",
      "enable_sequential_cpu_offload": false,
      "attention_mode": "sdpa"
    },
    "_meta": { "title": "CogVideoX Model Loader" }
  },
  "vae_loader": {
    "class_type": "CogVideoXVAELoader",
    "inputs": {
      "model_name": "cogvideox_vae_bf16.safetensors",
      "precision": "bf16"
    },
    "_meta": { "title": "CogVideoX VAE Loader" }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "t5xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "sd3",
      "device": "default"
    },
    "_meta": { "title": "Load CLIP (T5-XXL)" }
  },
  "positive": {
    "class_type": "CogVideoTextEncode",
    "inputs": {
      "clip": ["clip", 0],
      "prompt": "",
      "strength": 1.0,
      "force_offload": false
    },
    "_meta": { "title": "CogVideo TextEncode (Positive)" }
  },
  "negative": {
    "class_type": "CogVideoTextEncode",
    "inputs": {
      "clip": ["positive", 1],
      "prompt": "The video is not of a high quality, it has a low resolution. Watermark present in each frame. Strange motion trajectory. ",
      "strength": 1.0,
      "force_offload": true
    },
    "_meta": { "title": "CogVideo TextEncode (Negative)" }
  },
  "load_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": { "title": "Load Input Image" }
  },
  "resize": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["load_image", 0],
      "upscale_method": "lanczos",
      "width": 720,
      "height": 480,
      "crop": "center"
    },
    "_meta": { "title": "Resize to 720x480 (aspect-preserving center crop)" }
  },
  "i2v": {
    "class_type": "CogVideoImageEncode",
    "inputs": {
      "vae": ["vae_loader", 0],
      "start_image": ["resize", 0],
      "enable_tiling": false,
      "noise_aug_strength": 0.0
    },
    "_meta": { "title": "CogVideo ImageEncode" }
  },
  "sampler_1": {
    "class_type": "CogVideoSampler",
    "inputs": {
      "model": ["model_loader", 0],
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "num_frames": 49,
      "steps": 25,
      "cfg": 6.0,
      "seed": 0,
      "scheduler": "CogVideoXDDIM",
      "image_cond_latents": ["i2v", 0],
      "denoise_strength": 1.0
    },
    "_meta": { "title": "CogVideo Sampler" }
  },
  "decode": {
    "class_type": "CogVideoDecode",
    "inputs": {
      "vae": ["vae_loader", 0],
      "samples": ["sampler_1", 0],
      "enable_vae_tiling": true,
      "tile_sample_min_height": 240,
      "tile_sample_min_width": 360,
      "tile_overlap_factor_height": 0.2,
      "tile_overlap_factor_width": 0.2,
      "auto_tile_size": true
    },
    "_meta": { "title": "CogVideo Decode" }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode", 0],
      "fps": 8.0
    },
    "_meta": { "title": "Create Video" }
  },
  "save_video": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["create_video", 0],
      "filename_prefix": "video/mcs",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": { "title": "Save Video" }
  }
}
