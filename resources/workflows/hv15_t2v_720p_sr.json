{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "hunyuanvideo1.5_720p_t2v_fp16.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load Diffusion Model" }
  },
  "model_sampling": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["unet", 0],
      "shift": 7.0
    },
    "_meta": { "title": "ModelSamplingSD3" }
  },
  "clip": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "clip_name2": "byt5_small_glyphxl_fp16.safetensors",
      "type": "hunyuan_video_15",
      "device": "default"
    },
    "_meta": { "title": "DualCLIPLoader" }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["clip", 0]
    },
    "_meta": { "title": "CLIP Text Encode (Positive Prompt)" }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["clip", 0]
    },
    "_meta": { "title": "CLIP Text Encode (Negative Prompt)" }
  },
  "empty_latent": {
    "class_type": "EmptyHunyuanVideo15Latent",
    "inputs": {
      "width": 1280,
      "height": 720,
      "length": 121,
      "batch_size": 1
    },
    "_meta": { "title": "Empty HunyuanVideo 1.5 Latent" }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    },
    "_meta": { "title": "Random Noise" }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    },
    "_meta": { "title": "KSampler Select" }
  },
  "scheduler": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["unet", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    },
    "_meta": { "title": "Basic Scheduler" }
  },
  "cfg_guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["model_sampling", 0],
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "cfg": 6.0
    },
    "_meta": { "title": "CFG Guider" }
  },
  "sampler_1": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["cfg_guider", 0],
      "sampler": ["sampler_select", 0],
      "sigmas": ["scheduler", 0],
      "latent_image": ["empty_latent", 0]
    },
    "_meta": { "title": "Sampler Custom Advanced" }
  },
  "latent_upscale_loader": {
    "class_type": "LatentUpscaleModelLoader",
    "inputs": {
      "model_name": "hunyuanvideo15_latent_upsampler_1080p.safetensors"
    },
    "_meta": { "title": "Load Latent Upscale Model" }
  },
  "latent_upscale": {
    "class_type": "HunyuanVideo15LatentUpscaleWithModel",
    "inputs": {
      "model": ["latent_upscale_loader", 0],
      "samples": ["sampler_1", 0],
      "upscale_method": "bilinear",
      "width": 1920,
      "height": 1080,
      "crop": "disabled"
    },
    "_meta": { "title": "Latent Upscale With Model" }
  },
  "unet_sr": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "hunyuanvideo1.5_1080p_sr_distilled_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load SR Diffusion Model" }
  },
  "sr": {
    "class_type": "HunyuanVideo15SuperResolution",
    "inputs": {
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "vae": ["vae", 0],
      "latent": ["latent_upscale", 0],
      "noise_augmentation": 0.7
    },
    "_meta": { "title": "Hunyuan Video 1.5 Super Resolution (T2V — no start image)" }
  },
  "model_sampling_sr": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["unet_sr", 0],
      "shift": 2.0
    },
    "_meta": { "title": "ModelSamplingSD3 (SR)" }
  },
  "scheduler_sr": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["unet_sr", 0],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1.0
    },
    "_meta": { "title": "Basic Scheduler (SR)" }
  },
  "split_sigmas": {
    "class_type": "SplitSigmas",
    "inputs": {
      "sigmas": ["scheduler_sr", 0],
      "step": 4
    },
    "_meta": { "title": "Split Sigmas" }
  },
  "noise_sr": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    },
    "_meta": { "title": "Random Noise (SR)" }
  },
  "disable_noise": {
    "class_type": "DisableNoise",
    "inputs": {},
    "_meta": { "title": "Disable Noise" }
  },
  "sampler_select_sr": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    },
    "_meta": { "title": "KSampler Select (SR)" }
  },
  "cfg_guider_sr_1": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["model_sampling_sr", 0],
      "positive": ["sr", 0],
      "negative": ["sr", 1],
      "cfg": 1.0
    },
    "_meta": { "title": "CFG Guider (SR stage 1)" }
  },
  "cfg_guider_sr_2": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["unet_sr", 0],
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "cfg": 1.0
    },
    "_meta": { "title": "CFG Guider (SR stage 2)" }
  },
  "sampler_2": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise_sr", 0],
      "guider": ["cfg_guider_sr_1", 0],
      "sampler": ["sampler_select_sr", 0],
      "sigmas": ["split_sigmas", 0],
      "latent_image": ["sr", 2]
    },
    "_meta": { "title": "Sampler Custom Advanced (SR 1)" }
  },
  "sampler_3": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["disable_noise", 0],
      "guider": ["cfg_guider_sr_2", 0],
      "sampler": ["sampler_select_sr", 0],
      "sigmas": ["split_sigmas", 1],
      "latent_image": ["sampler_2", 0]
    },
    "_meta": { "title": "Sampler Custom Advanced (SR 2)" }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "hunyuanvideo15_vae_fp16.safetensors"
    },
    "_meta": { "title": "Load VAE" }
  },
  "decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["sampler_3", 0],
      "vae": ["vae", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    },
    "_meta": { "title": "VAE Decode (Tiled)" }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode", 0],
      "fps": 24.0
    },
    "_meta": { "title": "Create Video" }
  },
  "save_video": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["create_video", 0],
      "filename_prefix": "video/mcs",
      "format": "auto",
      "codec": "h264"
    },
    "_meta": { "title": "Save Video" }
  }
}
